  "runs": {
    "definition": {
      "schemaVersion": 2,
      "defaultLocale": "de",
      "locales": [
        "de"
      ],
      "disqualifiers": [
        {
          "when": {
            "mode": "all",
            "rules": [
              {
                "factKey": "processes_data",
                "op": "is_false"
              }
            ]
          },
          "message": {
            "de": "Ohne Datenverarbeitung ist keine Datenschutzerklärung nötig."
          }
        }
      ],
      "steps": [
        {
          "id": "s1",
          "key": "basics",
          "title": {
            "de": "Grundangaben"
          },
          "questions": [
            {
              "id": "processes_data_id",
              "required": true,
              "factKey": "processes_data",
              "answerType": "boolean",
              "plainQuestion": {
                "de": "Verarbeiten Sie Daten?"
              }
            },
            {
              "id": "country_id",
              "required": true,
              "factKey": "country",
              "answerType": "single",
              "plainQuestion": {
                "de": "Sitzland?"
              },
              "options": [
                {
                  "id": "de",
                  "label": {
                    "de": "Deutschland"
                  }
                },
                {
                  "id": "at",
                  "label": {
                    "de": "Österreich"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "s2",
          "key": "de_only",
          "title": {
            "de": "Nur Deutschland"
          },
          "showWhen": {
            "mode": "all",
            "rules": [
              {
                "factKey": "country",
                "op": "eq",
                "value": "de"
              }
            ]
          },
          "questions": [
            {
              "id": "has_dpo_id",
              "required": true,
              "factKey": "has_dpo",
              "answerType": "boolean",
              "plainQuestion": {
                "de": "Datenschutzbeauftragter?"
              }
            }
          ]
        },
        {
          "id": "s3",
          "key": "detail",
          "title": {
            "de": "Details"
          },
          "questions": [
            {
              "id": "dpo_name_id",
              "required": true,
              "factKey": "dpo_name",
              "answerType": "text",
              "plainQuestion": {
                "de": "Name des DSB?"
              },
              "askWhen": {
                "mode": "all",
                "rules": [
                  {
                    "factKey": "has_dpo",
                    "op": "is_true"
                  }
                ]
              }
            },
            {
              "id": "notes_id",
              "required": false,
              "factKey": "notes",
              "answerType": "text",
              "allowUnknown": true,
              "plainQuestion": {
                "de": "Anmerkungen?"
              }
            }
          ]
        }
      ]
    },
    "cases": [
      {
        "name": "stops at the first unanswered required question and folds nothing after it",
        "answers": {},
        "expect": {
          "facts": {},
          "pendingFactKey": "processes_data",
          "complete": false,
          "askedFactKeys": [
            "processes_data",
            "country",
            "notes"
          ],
          "terminal": null
        }
      },
      {
        "name": "a step whose showWhen fails is skipped entirely",
        "answers": {
          "processes_data": {
            "value": true
          },
          "country": {
            "value": "at"
          }
        },
        "expect": {
          "facts": {
            "processes_data": true,
            "country": "at"
          },
          "pendingFactKey": null,
          "complete": true,
          "askedFactKeys": [
            "processes_data",
            "country",
            "notes"
          ],
          "terminal": "assemble"
        }
      },
      {
        "name": "a question whose askWhen fails is not asked",
        "answers": {
          "processes_data": {
            "value": true
          },
          "country": {
            "value": "de"
          },
          "has_dpo": {
            "value": false
          }
        },
        "expect": {
          "facts": {
            "processes_data": true,
            "country": "de",
            "has_dpo": false
          },
          "pendingFactKey": null,
          "complete": true,
          "askedFactKeys": [
            "processes_data",
            "country",
            "has_dpo",
            "notes"
          ],
          "terminal": "assemble"
        }
      },
      {
        "name": "flipping the gate reveals the dependent question",
        "answers": {
          "processes_data": {
            "value": true
          },
          "country": {
            "value": "de"
          },
          "has_dpo": {
            "value": true
          }
        },
        "expect": {
          "facts": {
            "processes_data": true,
            "country": "de",
            "has_dpo": true
          },
          "pendingFactKey": "dpo_name",
          "complete": false,
          "askedFactKeys": [
            "processes_data",
            "country",
            "has_dpo",
            "dpo_name",
            "notes"
          ],
          "terminal": null
        }
      },
      {
        "name": "a stale answer for a question no longer asked does NOT enter the facts",
        "answers": {
          "processes_data": {
            "value": true
          },
          "country": {
            "value": "at"
          },
          "has_dpo": {
            "value": true
          },
          "dpo_name": {
            "value": "Frau Meier"
          }
        },
        "expect": {
          "facts": {
            "processes_data": true,
            "country": "at"
          },
          "pendingFactKey": null,
          "complete": true,
          "askedFactKeys": [
            "processes_data",
            "country",
            "notes"
          ],
          "terminal": "assemble"
        }
      },
      {
        "name": "a disqualifier stops the run and marks it not applicable",
        "answers": {
          "processes_data": {
            "value": false
          }
        },
        "expect": {
          "facts": {
            "processes_data": false
          },
          "pendingFactKey": null,
          "complete": false,
          "askedFactKeys": [
            "processes_data"
          ],
          "terminal": "not_applicable"
        }
      },
